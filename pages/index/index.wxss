.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

.container.light {
  background-color: #ffffff;
}

.container.dark {
  background-color: #000000;
}

.container.mirror {
  transform: scaleX(-1);
}

.container.fullscreen {
  padding: 0;
}

/* 输入模式 */
.input-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.input-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  margin-bottom: 16rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.dark .title {
  color: #fff;
}

.header-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  padding: 16rpx 32rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
}

.action-btn.small {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  background-color: #f0f0f0;
  color: #333;
}

.dark .action-btn.small {
  background-color: #333;
  color: #fff;
}

.action-btn.primary {
  background-color: #1296db;
  color: #fff;
}

.action-btn.primary.large {
  flex: 2;
  font-size: 32rpx;
  font-weight: bold;
}

.action-btn.secondary {
  background-color: #f5f5f5;
  color: #666;
}

.dark .action-btn.secondary {
  background-color: #333;
  color: #ccc;
}

.input-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-bottom: 16rpx;
}

.textarea {
  flex: 1;
  font-size: 32rpx;
  line-height: 1.8;
  padding: 24rpx;
  border-radius: 16rpx;
  background-color: #fafafa;
  border: 2rpx solid #e8e8e8;
  box-sizing: border-box;
}

.dark .textarea {
  background-color: #1a1a1a;
  border-color: #333;
  color: #fff;
}

.settings-area {
  background-color: #fafafa;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.dark .settings-area {
  background-color: #1a1a1a;
}

.setting-item {
  margin-bottom: 24rpx;
}

.setting-item:last-child {
  margin-bottom: 0;
}

.setting-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
}

.dark .setting-label {
  color: #aaa;
}

.setting-slider {
  width: 100%;
}

.setting-item.switches {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.toggle-btn {
  flex: 1;
  padding: 20rpx 16rpx;
  background-color: #fff;
  color: #666;
  border-radius: 12rpx;
  font-size: 26rpx;
  border: 2rpx solid #e0e0e0;
  margin: 0;
  text-align: center;
}

.dark .toggle-btn {
  background-color: #2a2a2a;
  border-color: #444;
  color: #aaa;
}

.toggle-btn.active {
  background-color: #e8f4fc;
  color: #1296db;
  border-color: #1296db;
}

.dark .toggle-btn.active {
  background-color: #1a3a4f;
  color: #4db5ff;
  border-color: #4db5ff;
}

.input-actions {
  display: flex;
  gap: 20rpx;
  padding-top: 8rpx;
}

.input-actions .action-btn {
  flex: 1;
}

/* 显示模式 */
.display-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
}

/* 跑马灯模式 */
.marquee-container {
  flex: 1;
  display: flex;
  align-items: center;
  overflow: hidden;
  background-color: #fff;
}

.marquee-container.dark {
  background-color: #000;
}

.marquee-wrapper {
  display: flex;
  white-space: nowrap;
}

.marquee-text {
  padding-right: 200rpx;
  color: #333;
  line-height: 1.6;
}

.dark .marquee-text {
  color: #fff;
}

/* 滚动模式 */
.scroll-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  background-color: #fff;
}

.scroll-container.dark {
  background-color: #000;
}

.text-scroll {
  flex: 1;
  padding: 40rpx;
  box-sizing: border-box;
}

.text-content {
  color: #333;
  word-break: break-all;
  white-space: pre-wrap;
}

.dark .text-content {
  color: #fff;
}

.scroll-padding {
  height: 500rpx;
}

/* 状态条 */
.status-bar {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: rgba(255, 255, 255, 0.95);
  border-top: 1rpx solid #e0e0e0;
}

.status-bar.dark {
  background-color: rgba(30, 30, 30, 0.95);
  border-top-color: #333;
}

.status-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.status-label {
  font-size: 22rpx;
  color: #999;
}

.status-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.dark .status-value {
  color: #fff;
}

.status-item.playing .status-dot {
  background-color: #4caf50;
  animation: pulse 1.5s infinite;
}

.status-item.paused .status-dot {
  background-color: #ff9800;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-bottom: 4rpx;
}

.status-text {
  font-size: 22rpx;
  color: #666;
}

.dark .status-text {
  color: #aaa;
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.5;
  }
}

/* 控制面板 */
.control-panel {
  background-color: rgba(255, 255, 255, 0.98);
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.control-panel.dark {
  background-color: rgba(30, 30, 30, 0.98);
}

.control-section {
  margin-bottom: 24rpx;
}

.control-section:last-child {
  margin-bottom: 0;
}

.control-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.main-controls {
  justify-content: center;
  gap: 32rpx;
}

.control-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 32rpx;
  border-radius: 16rpx;
  border: none;
  margin: 0;
}

.control-btn.icon {
  background-color: #f5f5f5;
  min-width: 120rpx;
}

.dark .control-btn.icon {
  background-color: #333;
}

.control-btn.icon.reset,
.control-btn.icon.exit {
  background-color: #ffebee;
}

.dark .control-btn.icon.reset,
.dark .control-btn.icon.exit {
  background-color: #3a1f1f;
}

.control-btn.icon.play-pause {
  width: 140rpx;
  height: 140rpx;
  background-color: #1296db;
  border-radius: 50%;
}

.control-btn.icon.play-pause.playing {
  background-color: #ff9800;
}

.icon-text {
  font-size: 40rpx;
  margin-bottom: 4rpx;
}

.icon-text.large {
  font-size: 56rpx;
  margin-bottom: 0;
  color: #fff;
}

.btn-text {
  font-size: 22rpx;
  color: #666;
}

.dark .btn-text {
  color: #aaa;
}

.control-btn.icon.reset .btn-text,
.control-btn.icon.exit .btn-text {
  color: #f44336;
}

/* 速度控制 */
.speed-control-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 40rpx;
  background-color: #e8f4fc;
  border-radius: 16rpx;
  border: none;
  margin: 0;
}

.dark .speed-control-btn {
  background-color: #1a3a4f;
}

.speed-icon {
  font-size: 48rpx;
  color: #1296db;
  font-weight: bold;
}

.dark .speed-icon {
  color: #4db5ff;
}

.speed-label {
  font-size: 24rpx;
  color: #1296db;
  margin-top: 4rpx;
}

.dark .speed-label {
  color: #4db5ff;
}

.speed-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 40rpx;
}

.speed-value {
  font-size: 56rpx;
  font-weight: bold;
  color: #1296db;
}

.dark .speed-value {
  color: #4db5ff;
}

.speed-unit {
  font-size: 24rpx;
  color: #999;
}

/* 快速设置 */
.quick-settings {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.quick-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 12rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  border: none;
  margin: 0;
}

.dark .quick-btn {
  background-color: #333;
}

.quick-btn.active {
  background-color: #e8f4fc;
  border: 2rpx solid #1296db;
}

.dark .quick-btn.active {
  background-color: #1a3a4f;
  border-color: #4db5ff;
}

.quick-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}

.quick-label {
  font-size: 22rpx;
  color: #666;
}

.dark .quick-label {
  color: #aaa;
}

.quick-btn.active .quick-label {
  color: #1296db;
}

.dark .quick-btn.active .quick-label {
  color: #4db5ff;
}

/* 字体大小 */
.font-size-section {
  padding-top: 8rpx;
}

.section-title {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.dark .section-title {
  color: #aaa;
}

.font-slider {
  width: 100%;
}

/* 隐藏控制面板按钮 */
.toggle-panel-btn {
  position: absolute;
  top: 40rpx;
  right: 40rpx;
  padding: 16rpx 32rpx;
  background-color: rgba(0, 0, 0, 0.7);
  color: #fff;
  border-radius: 8rpx;
  font-size: 24rpx;
  z-index: 100;
}

.toggle-panel-btn.dark {
  background-color: rgba(255, 255, 255, 0.2);
  color: #fff;
}
