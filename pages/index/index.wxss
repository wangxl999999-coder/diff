.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
}

/* 明亮主题 */
.container.light {
  background-color: #ffffff;
}

/* 暗黑主题 */
.container.dark {
  background-color: #000000;
}

/* 镜像模式 */
.container.mirror {
  transform: scaleX(-1);
}

/* 全屏模式 */
.container.fullscreen {
  padding: 0;
}

/* 输入容器 */
.input-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding: 20rpx;
}

.input-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e0e0e0;
}

.dark .input-header {
  border-bottom-color: #333;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.dark .title {
  color: #fff;
}

.header-actions {
  display: flex;
}

.textarea {
  flex: 1;
  font-size: 32rpx;
  line-height: 1.8;
  padding: 20rpx;
  margin: 20rpx 0;
  border-radius: 12rpx;
  background-color: #f9f9f9;
  border: 2rpx solid #e0e0e0;
}

.dark .textarea {
  background-color: #1a1a1a;
  border-color: #333;
  color: #fff;
}

.input-actions {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
}

.action-btn {
  padding: 20rpx 60rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn.primary {
  background-color: #1296db;
  color: #fff;
}

.action-btn.secondary {
  background-color: #f0f0f0;
  color: #333;
}

.dark .action-btn.secondary {
  background-color: #333;
  color: #fff;
}

/* 显示容器 */
.display-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
}

/* 跑马灯模式 */
.marquee-container {
  flex: 1;
  display: flex;
  align-items: center;
  overflow: hidden;
  padding: 40rpx 0;
}

.marquee-wrapper {
  display: flex;
  white-space: nowrap;
  animation: none;
}

.marquee-text {
  padding-right: 200rpx;
  color: #333;
  line-height: 1.6;
}

.dark .marquee-text {
  color: #fff;
}

/* 滚动模式 */
.scroll-container {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.text-scroll {
  flex: 1;
  padding: 40rpx;
}

.text-content {
  color: #333;
  line-height: 2;
  word-break: break-all;
  white-space: pre-wrap;
}

.dark .text-content {
  color: #fff;
}

.padding-bottom {
  height: 400rpx;
}

/* 控制面板 */
.control-panel {
  background-color: rgba(255, 255, 255, 0.95);
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.dark .control-panel {
  background-color: rgba(30, 30, 30, 0.95);
}

.control-row {
  margin-bottom: 20rpx;
}

.control-group {
  display: flex;
  flex-direction: column;
}

.control-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.dark .control-label {
  color: #aaa;
}

.control-slider {
  width: 100%;
}

.speed-buttons {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
}

.speed-btn {
  padding: 16rpx 40rpx;
  background-color: #e8f4fc;
  color: #1296db;
  border-radius: 8rpx;
  font-size: 26rpx;
  border: none;
  margin: 0;
}

.dark .speed-btn {
  background-color: #1a3a4f;
  color: #4db5ff;
}

.control-btn {
  padding: 20rpx 40rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  min-width: 180rpx;
}

.control-btn:last-child {
  margin-right: 0;
}

.control-btn.play {
  background-color: #1296db;
  color: #fff;
}

.control-btn.pause {
  background-color: #ff9800;
  color: #fff;
}

.control-group.switches {
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
}

.toggle-btn {
  padding: 16rpx 32rpx;
  background-color: #f0f0f0;
  color: #666;
  border-radius: 8rpx;
  font-size: 26rpx;
  border: none;
  margin: 0;
  min-width: 140rpx;
}

.dark .toggle-btn {
  background-color: #333;
  color: #aaa;
}

.toggle-btn.active {
  background-color: #1296db;
  color: #fff;
}

.back-btn {
  width: 100%;
  padding: 20rpx;
  background-color: #f5f5f5;
  color: #666;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: none;
  text-align: center;
}

.dark .back-btn {
  background-color: #2a2a2a;
  color: #aaa;
}

.hide-panel-btn {
  position: absolute;
  top: 40rpx;
  right: 40rpx;
  padding: 16rpx 32rpx;
  background-color: rgba(0, 0, 0, 0.6);
  color: #fff;
  border-radius: 8rpx;
  font-size: 24rpx;
  z-index: 100;
}

.control-group:first-child {
  flex-direction: row;
  align-items: center;
}
