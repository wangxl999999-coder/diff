<view class="container {{theme}} {{isFullScreen ? 'fullscreen' : ''}} {{isMirror ? 'mirror' : ''}}">
  <!-- 输入模式 -->
  <view wx:if="{{!isPlaying && !displayText}}" class="input-container">
    <view class="input-header">
      <text class="title">请输入提词内容</text>
      <view class="header-actions">
        <button class="action-btn" bindtap="goToHistory">历史记录</button>
      </view>
    </view>
    <textarea 
      class="textarea {{theme}}"
      placeholder="在这里输入您的提词内容...\n支持多行文本"
      value="{{text}}"
      bindinput="onTextInput"
      auto-height
      maxlength="-1"
    ></textarea>
    <view class="input-actions">
      <button class="action-btn secondary" bindtap="clearText">清空</button>
      <button class="action-btn primary" bindtap="togglePlay">开始提词</button>
    </view>
  </view>

  <!-- 提词显示模式 -->
  <view wx:else class="display-container">
    <!-- 跑马灯模式 -->
    <view wx:if="{{isMarquee}}" class="marquee-container">
      <view class="marquee-wrapper">
        <text 
          class="marquee-text {{theme}}"
          style="font-size: {{fontSize}}px; transform: translateX(-{{marqueeDistance}}px);"
        >{{marqueeText}}</text>
        <text 
          class="marquee-text {{theme}}"
          style="font-size: {{fontSize}}px; transform: translateX(-{{marqueeDistance}}px);"
        >{{marqueeText}}</text>
      </view>
    </view>

    <!-- 正常滚动模式 -->
    <view wx:else class="scroll-container">
      <scroll-view 
        class="text-scroll {{theme}}"
        scroll-y 
        scroll-top="{{scrollTop}}"
        enhanced
        show-scrollbar="false"
      >
        <view 
          class="text-content"
          style="font-size: {{fontSize}}px;"
          bind:transitionend="onTextAreaReady"
        >
          <text>{{displayText}}</text>
        </view>
        <view class="padding-bottom"></view>
      </scroll-view>
    </view>

    <!-- 控制面板 -->
    <view wx:if="{{showControlPanel}}" class="control-panel {{theme}}">
      <!-- 第一行：播放控制 -->
      <view class="control-row">
        <view class="control-group">
          <button class="control-btn {{isPlaying ? 'pause' : 'play'}}" bindtap="togglePlay">
            <text wx:if="{{!isPlaying}}">▶ 播放</text>
            <text wx:else>⏸ 暂停</text>
          </button>
          <button class="control-btn" bindtap="resetScroll">⏮ 重置</button>
        </view>
      </view>

      <!-- 第二行：字体大小 -->
      <view class="control-row">
        <view class="control-group">
          <text class="control-label">字体: {{fontSize}}px</text>
          <slider 
            class="control-slider"
            min="16" 
            max="120" 
            value="{{fontSize}}" 
            bindchange="onFontSizeChange"
            activeColor="#1296db"
          />
        </view>
      </view>

      <!-- 第三行：滚动速度 -->
      <view class="control-row">
        <view class="control-group">
          <text class="control-label">速度: {{scrollSpeed.toFixed(1)}}</text>
          <slider 
            class="control-slider"
            min="0.5" 
            max="10" 
            step="0.5"
            value="{{scrollSpeed}}" 
            bindchange="onSpeedChange"
            activeColor="#1296db"
          />
          <view class="speed-buttons">
            <button class="speed-btn" bindtap="decreaseSpeed">减速</button>
            <button class="speed-btn" bindtap="increaseSpeed">加速</button>
          </view>
        </view>
      </view>

      <!-- 第四行：功能开关 -->
      <view class="control-row">
        <view class="control-group switches">
          <button class="toggle-btn {{theme === 'dark' ? 'active' : ''}}" bindtap="toggleTheme">
            {{theme === 'dark' ? '🌙 暗黑' : '☀️ 明亮'}}
          </button>
          <button class="toggle-btn {{isFullScreen ? 'active' : ''}}" bindtap="toggleFullScreen">
            {{isFullScreen ? '退出全屏' : '全屏'}}
          </button>
          <button class="toggle-btn {{isMirror ? 'active' : ''}}" bindtap="toggleMirror">
            {{isMirror ? '取消镜像' : '镜像'}}
          </button>
          <button class="toggle-btn {{isMarquee ? 'active' : ''}}" bindtap="toggleMarquee">
            {{isMarquee ? '正常滚动' : '跑马灯'}}
          </button>
        </view>
      </view>

      <!-- 第五行：返回编辑 -->
      <view class="control-row">
        <button class="back-btn" bindtap="resetScroll">返回编辑</button>
      </view>
    </view>

    <!-- 隐藏控制面板按钮 (全屏时显示) -->
    <view wx:if="{{isFullScreen}}" class="hide-panel-btn" bindtap="toggleControlPanel">
      {{showControlPanel ? '隐藏控制' : '显示控制'}}
    </view>
  </view>
</view>
